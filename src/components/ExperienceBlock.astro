---
import { getCollection } from 'astro:content';
import Title from './Title.astro';
import { localizeExperience } from '../i18n/content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Obtener todas las experiencias desde MDX
const allExperiences = await getCollection('experience');

// Ordenar por orden especificado en frontmatter o por orden numérico
const experiences = allExperiences
  .sort((a, b) => {
    if (a.data.order && b.data.order) {
      return a.data.order - b.data.order;
    }
    return a.data.company.localeCompare(b.data.company);
  })
  .map((entry) => localizeExperience(entry, lang));

---

<section id="experience" class="py-20 flex items-center">
  <div class="w-full">

    <!-- Header -->
    <div class="text-center mb-14">
      <div class="w-full flex justify-center">
        <Title title={t.experience.title} />
      </div>
      <p class="text-xl mt-6 w-full leading-relaxed text-ink-soft font-semibold">
        {t.experience.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {experiences.map((exp, index) => {
        // Primera experiencia ocupa todo el ancho en desktop
        const isFeatured = index === 0;
        const rotClass = index % 2 === 0 ? 'tile-rot-b' : 'tile-rot-a';

        return (
          <div class={`tile group ${isFeatured ? 'md:col-span-2 tile-feat' : rotClass}`}>
            <span class="big-num">{String(index + 1).padStart(2, '0')}</span>

            <div class="relative z-10 flex flex-col space-y-3 h-full">
              <!-- Cabecera -->
              <div class="flex-shrink-0">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
                  <h3 class={`font-display font-extrabold tracking-tight leading-tight ${isFeatured ? 'text-3xl md:text-5xl text-[#1c1300]' : 'text-xl 2xl:text-2xl text-ink'}`}>
                    {exp.company}
                  </h3>
                  <div class="flex flex-wrap gap-2 justify-start lg:justify-end">
                    {exp.roles.map((role) => (
                      <span class={`chip ${isFeatured ? '' : 'chip-gold'}`}>
                        {role}
                      </span>
                    ))}
                  </div>
                </div>

                <p class={`text-sm mt-3 flex items-center gap-2 font-mono font-bold ${isFeatured ? 'text-[#1c1300]/80' : 'text-ink-soft'}`}>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  {exp.period}
                </p>
              </div>

              <!-- Tareas -->
              <div class="flex-grow">
                <ul class={`space-y-2 ${isFeatured ? 'text-[#1c1300]' : 'text-ink'}`}>
                  {exp.tasks.map((task) => (
                    <li class="flex items-start gap-2">
                      <span class={`font-bold text-xs mt-1.5 ${isFeatured ? 'text-white' : 'text-gold-ink'}`}>●</span>
                      <p class="flex-1 text-base font-semibold">{task}</p>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Tecnologías -->
              <div class="flex-shrink-0 pt-4">
                <div class="flex flex-wrap gap-2 justify-start">
                  {exp.technologies.map((tech) => (
                    <span class="chip">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  import { makeTilt } from '../scripts/tilt.js';
  makeTilt('#experience .tile', 5);
</script>

---
import Title from './Title.astro';
import { contactData } from '../data/contact';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  class?: string;
  variant?: 'default' | 'compact';
}

const {
  class: className = '',
  variant = 'default'
} = Astro.props;
---

<section id="contact" class={`py-20 ${className}`}>
  <div class="w-full">

    <!-- Header -->
    <div class="text-center mb-10">
      <Title title={t.contact.title}></Title>
      <p class="text-lg text-ink-soft font-semibold mt-6 leading-relaxed max-w-3xl mx-auto">
        {t.contact.subtitle}
      </p>
    </div>

    <!-- Banda oscura con rayas doradas -->
    <div class="contact-band">
      <div class="relative z-10 flex flex-col gap-10">
        <div class="text-center">
          <span class="eyebrow text-gold border-2 border-gold bg-white/5 px-4 py-2 rounded-full rotate-[-2deg]">
            {t.contact.eyebrow}
          </span>
          <h2 class="font-display font-extrabold text-4xl md:text-5xl text-white tracking-tight leading-none mt-6">
            {t.contact.headline}
          </h2>
        </div>

        <!-- Contact Methods Grid -->
        <div class="grid md:grid-cols-2 gap-8 lg:gap-10 w-full">

          <!-- Email -->
          <div class="bg-white border-3 border-ink rounded-[26px] p-8 shadow-[8px_8px_0_var(--gold)] hover:-translate-y-1 hover:shadow-[10px_10px_0_var(--gold)] transition-all duration-200 flex flex-col text-center rotate-[-0.6deg] hover:rotate-[-0.6deg]">
            <div class="icon-chip mb-6 mx-auto">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <h3 class="font-display font-extrabold text-2xl text-ink uppercase tracking-tight mb-2">
              {t.contact.email.title}
            </h3>
            <p class="font-mono text-xs font-bold text-muted uppercase tracking-wide mb-7 flex-grow">{t.contact.email.description}</p>
            <a
              href={`mailto:${contactData.email}`}
              class="btn btn-gold w-full justify-center"
            >
              {t.contact.email.cta} <span class="arr">→</span>
            </a>
          </div>

          <!-- LinkedIn -->
          <div class="bg-white border-3 border-ink rounded-[26px] p-8 shadow-[8px_8px_0_var(--gold)] hover:-translate-y-1 hover:shadow-[10px_10px_0_var(--gold)] transition-all duration-200 flex flex-col text-center rotate-[0.6deg] hover:rotate-[0.6deg]">
            <div class="icon-chip mb-6 mx-auto">
              <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <h3 class="font-display font-extrabold text-2xl text-ink uppercase tracking-tight mb-2">
              {t.contact.linkedin.title}
            </h3>
            <p class="font-mono text-xs font-bold text-muted uppercase tracking-wide mb-7 flex-grow">{t.contact.linkedin.description}</p>
            <a
              href={contactData.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-gold w-full justify-center"
            >
              {t.contact.linkedin.cta} <span class="arr">→</span>
            </a>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-band {
    position: relative;
    background: var(--ink-strong);
    border: 3px solid var(--ink-strong);
    border-radius: 36px;
    padding: 48px 52px;
    overflow: hidden;
  }

  .contact-band::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(-45deg, rgba(246, 166, 13, 0.06) 0 2px, transparent 2px 22px);
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .contact-band {
      padding: 32px 24px;
    }
  }
</style>

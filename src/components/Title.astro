---
export interface Props {
  title: string;
}
const {
    title = ""
}= Astro.props
---
<div class="w-full flex justify-center mb-8">
  <div class="bg-ink rounded-2xl py-3 px-8 w-fit rotate-[-1.5deg] shadow-[6px_6px_0_var(--gold)]">
    <h2 class="font-display font-extrabold text-3xl 2xl:text-5xl tracking-tight text-white uppercase break-all leading-none">{title}<span class="text-gold">.</span></h2>
  </div>
</div>

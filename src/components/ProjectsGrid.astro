---
import { getCollection } from 'astro:content';
import Title from './Title.astro';
import { localizeProject } from '../i18n/content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allProjects = await getCollection('projects', ({ data }) => !data.featured);

const projects = allProjects
  .sort((a, b) => {
    if (a.data.order && b.data.order) {
      return a.data.order - b.data.order;
    }
    return a.data.title.localeCompare(b.data.title);
  })
  .map((entry) => localizeProject(entry, lang));

// Solo el primer proyecto marcado como principal recibe el tile dorado
const featuredIndex = projects.findIndex((p) => p.isMainProject);
---

<section id="projects" class="py-12 md:py-20 flex items-center">
  <div class="w-full">

    <div class="text-center mb-10 md:mb-16">
      <div class="w-full flex justify-center">
        <Title title={t.projects.title} />
      </div>
      <p class="text-base md:text-xl mt-4 md:mt-6 w-full leading-relaxed text-ink-soft font-semibold px-2">
        {t.projects.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 mb-10 md:mb-16 items-stretch w-full">
      {projects.map((project, index) => {
        const isFeatured = index === featuredIndex;
        const rotClass = index % 2 === 0 ? 'tile-rot-a' : 'tile-rot-b';

        return (
          <div class={`tile group w-full ${isFeatured ? 'tile-feat' : rotClass}`}>
            <span class="big-num">{String(index + 1).padStart(2, '0')}</span>

            <div class="relative z-10 flex flex-col space-y-3 h-full">
              <div class="flex-shrink-0 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 sm:gap-3">
                <h3 class={`font-display font-extrabold tracking-tight text-xl md:text-2xl ${isFeatured ? 'text-[#1c1300] text-3xl md:text-4xl leading-tight' : 'text-ink'}`}>
                  {project.title}
                </h3>
                <span class="chip flex-shrink-0 w-fit">
                  {project.tag}
                </span>
              </div>

              <div class="flex-grow">
                <p class={`text-sm leading-relaxed font-semibold ${isFeatured ? 'text-[#1c1300]' : 'text-ink-soft'}`}>
                  {project.description}
                </p>
                {project.features && (
                  <ul class={`text-sm space-y-1.5 mt-3 ${isFeatured ? 'text-[#1c1300]' : 'text-ink'}`}>
                    {project.features.map((feature) => (
                      <li class="flex items-start gap-2">
                        <span class={`font-bold text-xs mt-1 ${isFeatured ? 'text-white' : 'text-gold-ink'}`}>●</span>
                        <p class="flex-1 text-sm font-semibold">{feature}</p>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <div class="flex-shrink-0 pt-3 flex flex-col md:flex-row md:items-end md:justify-between gap-3">
                {project.technologies && (
                  <div class="flex flex-wrap gap-2">
                    {project.technologies.map((tech) => (
                      <span class="chip">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}

                {project.url && (
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mini-btn group/link"
                  >
                    {t.projects.viewProject}
                    <svg class="w-4 h-4 group-hover/link:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 12h14m-7-7l7 7-7 7"></path>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  import { makeTilt } from '../scripts/tilt.js';
  makeTilt('#projects .tile', 5);
</script>

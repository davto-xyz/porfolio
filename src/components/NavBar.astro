---
import { Image } from 'astro:assets';
import Logo from '../assets/images/logo.png';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';

export interface Props {
  links?: Array<{
    href: string;
    text: string;
    active?: boolean;
    isHighlight?: boolean;
  }>;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homePath = localizePath('/', lang);

const {
  links = [
    { href: "#projects", text: t.nav.projects },
    { href: "#experience", text: t.nav.experience },
    { href: "#skills", text: t.nav.skills },
    { href: "#about", text: t.nav.about },
    { href: "#contact", text: t.nav.contact }
  ]
} = Astro.props;

---

<!-- Unified Navigation Bar -->
<nav class="navbar-animate w-full max-w-full overflow-hidden pt-5 py-2 sm:py-4 px-4 sm:px-8" id="navbar">
  <div class="flex items-center justify-between w-full max-w-full">
    <!-- Logo -->
    <div class="navbar-animate flex-shrink-0 overflow-hidden rounded-2xl border-3 border-ink rotate-[-2deg] shadow-[5px_5px_0_var(--gold)] hover:-translate-y-1 hover:shadow-[7px_7px_0_var(--gold)] transition-all duration-300 bg-white">
      <a href={homePath} class="block">
        <Image alt="David Torres Logo" src={Logo} class="w-16 sm:w-20" />
      </a>
    </div>

    <!-- Language switcher + Download CV Button on the right -->
    <div class="navbar-animate flex flex-wrap items-stretch justify-end gap-2 sm:gap-3">
      <LanguageSwitcher />
      <a
        href={t.nav.cvHref}
        class="btn btn-primary py-3! px-5! text-base"
        title={t.nav.cv}
        aria-label={t.nav.cv}
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-6 h-6"><path fill="currentColor" d="M4 4a2 2 0 0 1 2-2h8a1 1 0 0 1 .707.293l5 5A1 1 0 0 1 20 8v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm13.586 4L14 4.414V8zM12 4H6v16h12V10h-5a1 1 0 0 1-1-1zm0 7.5a1 1 0 0 1 1 1v2.586l.293-.293a1 1 0 0 1 1.414 1.414l-2 2a1 1 0 0 1-1.414 0l-2-2a1 1 0 1 1 1.414-1.414l.293.293V12.5a1 1 0 0 1 1-1"/></svg>
        CV
      </a>
    </div>
  </div>
</nav>

<!-- Left Sidebar Navigation (Desktop Only) -->
<nav class="navbar-animate fixed left-4 top-1/2 -translate-y-1/2 z-40 hidden md:block">
  <div class="bg-white border-3 border-ink rounded-full py-5 px-1.5 shadow-[6px_6px_0_var(--gold)]">
    <div class="flex flex-col items-center gap-2.5">
      {links.map((link) => (
        <a
          href={link.href}
          class={`
            uppercase text-xs font-bold font-mono tracking-widest block text-center rounded-full p-3 border-2 transition-all duration-200
            ${link.active
              ? 'bg-gold text-ink border-ink shadow-[3px_3px_0_var(--ink-strong)]'
              : 'text-ink border-transparent hover:bg-gold/20 hover:border-ink/30'
            }
          `}
          style="writing-mode: vertical-rl; text-orientation: mixed;"
        >
          {link.text}
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  .navbar-animate {
    opacity: 0;
    transform: translateY(-20px);
    animation: fadeInDown 0.8s ease-out forwards;
  }

  .navbar-animate:nth-child(1) { animation-delay: 0.1s; }
  .navbar-animate:nth-child(2) { animation-delay: 0.2s; }
  .navbar-animate:nth-child(3) { animation-delay: 0.3s; }
  .navbar-animate:nth-child(4) { animation-delay: 0.4s; }

  @keyframes fadeInDown {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar-animate {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

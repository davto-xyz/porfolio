---
import Title from "./Title.astro"
import Photo from "../assets/images/Sujeto.png"
import { Image } from "astro:assets"
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Component About Me simplificado
---

<section id="about" class="flex font-sans font-inter items-center justify-center min-h-screen text-center md:text-justify py-20">


  <div class="flex flex-col items-center justify-center w-full max-w-7xl mx-auto">



    <!-- Title -->
    <div class="flex items-center gap-4 text-entrance-bottom delay-100 justify-center text-center mb-12" data-speed="0.7">
     <Title title={t.about.title}></Title>
    </div>
    <div class="flex items-center justify-center flex-col 2xl:flex-row gap-8 2xl:gap-16">


    <div class="w-full 2xl:w-1/2 flex justify-center">
      <div class="overflow-hidden">
        <Image alt={t.about.imageAlt} src={Photo} class="w-80 h-80 2xl:w-96 2xl:h-96 rounded-full object-cover border-3 border-gray-950"/>
      </div>
    </div>
  <!-- Right Column - About Text -->
      <div class="flex-1">


        <div class="space-y-3 text-gray-800   tracking-normal text-justify break-words">
          <p class="text-2xl font-bold text-center 2xl:text-left text-gray-900 font-stretch-expanded">
            {t.about.greeting}
          </p>
          {t.about.paragraphs.map((paragraph) => (
            <p class="text-lg leading-relaxed">
              {paragraph}
            </p>
          ))}


        </div>


    </div>
    </div>
  </div>
</section>

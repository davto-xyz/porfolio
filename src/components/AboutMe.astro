---
import Title from "./Title.astro"
import Photo from "../assets/images/Sujeto.png"
import { Image } from "astro:assets"
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Component About Me simplificado
---

<section id="about" class="flex font-sans items-center justify-center py-20">

  <div class="flex flex-col items-center justify-center w-full max-w-7xl mx-auto">


    <!-- Title -->
    <div class="flex items-center gap-4 text-entrance-bottom delay-100 justify-center text-center mb-12" data-speed="0.7">
     <Title title={t.about.title}></Title>
    </div>
    <div class="flex items-center justify-center flex-col 2xl:flex-row gap-12 2xl:gap-20">

    <div class="w-full 2xl:w-1/2 flex justify-center">
      <div class="relative text-entrance-bottom delay-400">
        <div class="bg-white border-3 border-ink rounded-2xl p-3 rotate-[2deg] shadow-[9px_9px_0_var(--ink-strong)]" data-about-tilt>
          <Image alt={t.about.imageAlt} src={Photo} class="w-72 h-72 2xl:w-96 2xl:h-96 rounded-xl object-cover border-2 border-ink"/>
        </div>
        <div class="absolute -right-4 -bottom-4 flex items-center gap-2 bg-ink text-white border-3 border-ink rounded-2xl px-4 py-3 shadow-[5px_5px_0_#fff,5px_5px_0_3px_var(--ink-strong)] font-mono text-xs font-bold whitespace-nowrap rotate-[3deg]">
          <b class="text-gold text-sm">✦</b> {t.about.chip}
        </div>
      </div>
    </div>
  <!-- Right Column - About Text -->
      <div class="flex-1">
        <div class="space-y-4 tracking-normal text-justify break-words text-ink-soft">
          <p class="font-display font-extrabold text-3xl text-ink tracking-tight">
            {t.about.greeting}
          </p>
          {t.about.paragraphs.map((paragraph) => (
            <p class="text-lg leading-relaxed">
              {paragraph}
            </p>
          ))}


        </div>


    </div>
    </div>
  </div>
</section>

<script>
  import { makeTilt } from '../scripts/tilt.js';
  makeTilt('[data-about-tilt]', 6);
</script>

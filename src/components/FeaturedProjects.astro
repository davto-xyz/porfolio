---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Title from './Title.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const featuredProjects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// Capturas de cada proyecto en src/assets/images/projects/<name>/, ordenadas por nombre de archivo
const screenshotModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/projects/*/*.{png,jpg,jpeg,webp}',
  { eager: true }
);

const getScreenshots = (name: string) =>
  Object.entries(screenshotModules)
    .filter(([path]) => path.includes(`/projects/${name}/`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);
---

{featuredProjects.length > 0 && (
  <section id="featured" class="py-12 md:py-20 flex items-center">
    <div class="w-full">

      <div class="text-center mb-10 md:mb-16">
        <div class="w-full flex justify-center">
          <Title title={t.projects.featured} />
        </div>
        <p class="text-base md:text-xl mt-4 md:mt-6 w-full leading-relaxed text-ink-soft font-semibold px-2">
          {t.projects.featuredSubtitle}
        </p>
      </div>

      <div class="flex flex-col gap-6 md:gap-8">
        {featuredProjects.map((project) => {
          const screenshots = getScreenshots(project.data.name);
          return (
            <article class="tile tile-cream w-full">
              <span class="big-num">✦</span>

              <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
                <div class="flex flex-col gap-4">
                  <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
                    <h3 class="font-display font-extrabold tracking-tight leading-tight text-3xl md:text-4xl 2xl:text-5xl text-ink">
                      {project.data.title}
                    </h3>
                    <span class="chip chip-gold flex-shrink-0 w-fit">
                      {project.data.tag}
                    </span>
                  </div>

                  <p class="text-ink-soft text-base leading-relaxed font-semibold">
                    {project.data.description}
                  </p>

                  {project.data.features && (
                    <ul class="text-ink space-y-2">
                      {project.data.features.map((feature) => (
                        <li class="flex items-start gap-2">
                          <span class="text-gold-ink font-bold text-xs mt-1.5">●</span>
                          <p class="flex-1 text-sm md:text-base font-semibold">{feature}</p>
                        </li>
                      ))}
                    </ul>
                  )}

                  {project.data.technologies && (
                    <div class="flex flex-wrap gap-2 pt-2">
                      {project.data.technologies.map((tech) => (
                        <span class="chip">
                          {tech}
                        </span>
                      ))}
                    </div>
                  )}

                  {project.data.url && (
                    <a
                      href={project.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-auto mini-btn group/link w-fit"
                    >
                      {project.data.url.includes('apps.apple.com') ? t.projects.downloadAppStore : t.projects.viewProject}
                      <svg class="w-4 h-4 group-hover/link:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 12h14m-7-7l7 7-7 7"></path>
                      </svg>
                    </a>
                  )}
                </div>

                {screenshots.length > 0 && (
                  <div class="flex items-center justify-center gap-3 md:gap-5">
                    {screenshots.slice(0, 3).map((shot, i) => (
                      <Image
                        src={shot}
                        alt={`${project.data.alt} — captura ${i + 1}`}
                        widths={[240, 480]}
                        sizes="(min-width: 1024px) 220px, 30vw"
                        class:list={[
                          'w-[30%] max-w-[220px] h-auto rounded-[1.5rem] md:rounded-[2rem] border-3 border-ink shadow-[6px_6px_0_var(--ink-strong)] transition-transform duration-500',
                          i === 1 ? '-translate-y-4 md:-translate-y-6 group-hover:-translate-y-8 rotate-[1.5deg]' : 'translate-y-2 md:translate-y-4 rotate-[-1.5deg]',
                        ]}
                      />
                    ))}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}
